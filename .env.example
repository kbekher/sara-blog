# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Time zone used to display post dates (IANA name)
NEXT_PUBLIC_SITE_TIMEZONE=Europe/Paris

# ── Database (Vercel → Storage → Neon Postgres; auto-injected) ──
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Images (Vercel → Storage → Blob; auto-injected) ──
BLOB_READ_WRITE_TOKEN=

# ── Admin login ────────────────────────────────────────
ADMIN_EMAIL=sara@example.com
# Generate with: npm run hash-password -- "your-password"
# Use the printed b64:… form — raw bcrypt hashes contain `$`, which Next.js expands inside .env files.
ADMIN_PASSWORD_HASH=
# Random 32+ char string: openssl rand -base64 32
SESSION_SECRET=

# ── Unsplash (https://unsplash.com/developers → New Application → Access Key) ──
UNSPLASH_ACCESS_KEY=

# ── Microsoft Translator (Azure AI Translator) ─────────
# Azure portal → Create a resource → "Translator" → Pricing tier F0 (free, 2M chars/month)
# → region e.g. West Europe → Create → Keys and Endpoint: KEY 1 + Location/Region.
# Without a key, posts are published without translations (the site shows the Russian original).
AZURE_TRANSLATOR_KEY=
# Resource region, e.g. westeurope (required unless the resource is "Global")
AZURE_TRANSLATOR_REGION=
# Optional; defaults to https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_ENDPOINT=

# ── LanguageTool (optional; leave empty to use the free public API) ──
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=

# ── Brevo newsletter (https://app.brevo.com → SMTP & API → API keys) ──
BREVO_API_KEY=
BREVO_LIST_ID=
# Optional double opt-in: template id + redirect URL after confirmation
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
